{
	frankenphp
}

# HTTP simple sur le réseau Docker : le HTTPS est assuré par Cloudflare (tunnel)
{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd br gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Défense en profondeur : jamais d'exécution de PHP dans les fichiers envoyés
	@phpInUploads path /uploads/*.php /uploads/*/*.php /uploads/*/*/*.php
	respond @phpInUploads 403

	@uploads path /uploads/* /assets/*
	header @uploads Cache-Control "public, max-age=604800"

	php_server
}
