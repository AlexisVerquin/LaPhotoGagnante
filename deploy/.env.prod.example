# Modèle du fichier de configuration de PRODUCTION.
# À copier sur le serveur dans /srv/photoprix/.env.prod (hors du dépôt), puis : chmod 600
# Ne JAMAIS versionner le vrai fichier. Remplacer toutes les valeurs « change-me ».
#
# Générer un secret : openssl rand -hex 32
# Mots de passe : sans caractères spéciaux d'URL (@ : / ? # %) car ils sont repris dans les DSN ci-dessous.

###> Symfony ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-openssl-rand-hex-32
# Adresse publique du site (liens dans les emails envoyés hors requête HTTP, ex. app:set-winner)
DEFAULT_URI=https://photoprix.example.fr

# Le site est derrière Cloudflare Tunnel -> cloudflared -> FrankenPHP (réseau Docker privé).
# Indispensable pour connaître la vraie IP des visiteurs (limites de connexion et de contact)
# et savoir que la requête d'origine est en HTTPS.
SYMFONY_TRUSTED_PROXIES=private_ranges
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto
# Seuls ces noms de domaine sont acceptés (expression régulière, échapper les points)
SYMFONY_TRUSTED_HOSTS=^photoprix\.example\.fr$
###< Symfony ###

###> Base de données ###
MYSQL_DATABASE=photoprix
MYSQL_USER=photoprix
MYSQL_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root
# Doit reprendre exactement MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE ci-dessus
DATABASE_URL="mysql://photoprix:change-me-db@database:3306/photoprix?serverVersion=8.4.0&charset=utf8mb4"
###< Base de données ###

###> Messenger (RabbitMQ) ###
RABBITMQ_DEFAULT_USER=photoprix
RABBITMQ_DEFAULT_PASS=change-me-rabbit
MESSENGER_TRANSPORT_DSN=amqp://photoprix:change-me-rabbit@rabbitmq:5672/%2f/messages
###< Messenger ###

###> Emails ###
# Un vrai serveur SMTP (fournisseur d'emails, hébergeur du domaine…)
MAILER_DSN=smtp://utilisateur:mot-de-passe@smtp.example.fr:587
MAILER_FROM="LaPhotoGagnante <no-reply@photoprix.example.fr>"
ADMIN_MAIL=admin@photoprix.example.fr
###< Emails ###

###> Connexion Google / Facebook (facultatif : laisser vide pour masquer le bouton) ###
# Création des applications : voir deploy/README.md, section « Connexion Google / Facebook »
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
###< Connexion Google / Facebook ###

###> Cloudflare Tunnel ###
# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel (type Cloudflared) > copier le jeton
CLOUDFLARE_TUNNEL_TOKEN=change-me
###< Cloudflare Tunnel ###
