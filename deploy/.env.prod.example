# Modèle de la config de production, à copier dans /srv/laphotogagnante/.env.prod (chmod 600, jamais dans git).
# Remplacez chaque « change-me » ; pour un secret : openssl rand -hex 32.
#
# Évitez @ : / ? # % dans les mots de passe, ils sont réutilisés dans des URL plus bas.

###> Symfony ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-openssl-rand-hex-32
# L'adresse du site, pour les liens des emails envoyés par les commandes (app:set-winner…).
DEFAULT_URI=https://laphotogagnante.fr

# Indispensable derrière Cloudflare : sans ça, tous les visiteurs auraient l'IP du tunnel
# et les limites de connexion et de contact bloqueraient tout le monde.
SYMFONY_TRUSTED_PROXIES=private_ranges
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto
# Le domaine accepté, sous forme d'expression régulière (d'où les points échappés).
SYMFONY_TRUSTED_HOSTS=^laphotogagnante\.fr$
###< Symfony ###

###> Base de données ###
MYSQL_DATABASE=laphotogagnante
MYSQL_USER=laphotogagnante
MYSQL_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root
# Mêmes utilisateur, mot de passe et base que juste au-dessus.
DATABASE_URL="mysql://laphotogagnante:change-me-db@database:3306/laphotogagnante?serverVersion=8.4.0&charset=utf8mb4"
###< Base de données ###

###> Messenger (RabbitMQ) ###
RABBITMQ_DEFAULT_USER=laphotogagnante
RABBITMQ_DEFAULT_PASS=change-me-rabbit
MESSENGER_TRANSPORT_DSN=amqp://laphotogagnante:change-me-rabbit@rabbitmq:5672/%2f/messages
###< Messenger ###

###> Emails ###
# Le serveur d'envoi : Brevo (identifiant et clé SMTP dans Brevo > SMTP & API > SMTP).
# Le @ de l'identifiant s'écrit %40 dans l'URL.
MAILER_DSN=smtp://change-me%40smtp-brevo.com:change-me-smtp@smtp-relay.brevo.com:587
MAILER_FROM="LaPhotoGagnante <no-reply@laphotogagnante.fr>"
ADMIN_MAIL=admin@laphotogagnante.fr
###< Emails ###

###> Mentions légales ###
# Adresse de l'éditeur : laisser vide pour ne pas la publier (éditeur non professionnel,
# identifié auprès de l'hébergeur, LCEN art. 6-III-2). Nom et adresse de l'hébergeur : config/packages/legal.yaml.
LEGAL_EDITOR_ADDRESS=
# Téléphone de l'hébergeur (Scaleway SAS), obligatoire : à recopier depuis https://www.scaleway.com/fr/mentions-legales
LEGAL_HOST_PHONE=
###< Mentions légales ###

###> Connexion Google / Facebook (facultatif : laisser vide pour masquer le bouton) ###
# Comment créer les applications : deploy/README.md, section 3 bis.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
###< Connexion Google / Facebook ###
