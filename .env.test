# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base de test : "app" + suffixe "_test" (cf. doctrine.yaml). Compte root car l'utilisateur
# applicatif n'a de droits que sur la base "app". MYSQL_ROOT_PASSWORD vient de .env.
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD}@database:3306/app?serverVersion=8.4.0&charset=utf8mb4"
MAILER_DSN=null://null

# Faux identifiants : affichent les boutons Google / Facebook ; les appels aux fournisseurs
# sont remplacés par App\Tests\Security\FakeOAuthClient dans les tests
OAUTH_GOOGLE_CLIENT_ID=test-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=test-google-secret
OAUTH_FACEBOOK_CLIENT_ID=test-facebook-client-id
OAUTH_FACEBOOK_CLIENT_SECRET=test-facebook-secret
