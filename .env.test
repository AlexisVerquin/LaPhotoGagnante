# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# La base de test s'appelle app_test, et il faut le compte root pour la créer.
# MYSQL_ROOT_PASSWORD vient de .env.
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD}@database:3306/app?serverVersion=8.4.0&charset=utf8mb4"
MAILER_DSN=null://null

# De faux identifiants, juste pour que les boutons Google / Facebook s'affichent.
# Les tests ne contactent jamais les vrais services (cf. FakeOAuthClient).
OAUTH_GOOGLE_CLIENT_ID=test-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=test-google-secret
OAUTH_FACEBOOK_CLIENT_ID=test-facebook-client-id
OAUTH_FACEBOOK_CLIENT_SECRET=test-facebook-secret

# Fausses coordonnées : les pages légales doivent s'afficher sans « À compléter »
LEGAL_EDITOR_ADDRESS="8, rue de la Ville-l’Évêque, 75008 Paris, France"
