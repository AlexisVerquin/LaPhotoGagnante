<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body data-controller="modal uploadfile" data-action="uploadfile:success->modal#close">
        <div class="container-fluid m-0 p-0">
            {% include 'partials/_navbar.html.twig' with {'hide_auth_actions': app.request.attributes.get('_route') in ['app_login', 'app_register']} %}
            {% set flashList = [] %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    {% set flashList = flashList|merge([{ type: type, message: message }]) %}
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
        <div class="modal fade" data-modal-target="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5">
                            {% if not getPhotoCurrentTheme() %}
                                Envoyer votre photo
                            {% else %}
                                Votre photo
                            {% endif %}

                        </h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div>
                        <div class="modal-body d-flex flex-column align-items-center">
                            <div class="alert alert-danger alert-dismissible fade m-4" role="alert" data-uploadfile-target="alert" hidden>
                                <span data-uploadfile-target="alertMessage"></span>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                            <img
                                data-uploadfile-target="preview"
                                width="600px"
                                src="{% if not getPhotoCurrentTheme() %}{{ asset('images/default_images.jpg') }}{% else %} {{ asset(getPhotoCurrentTheme()) }} {% endif %}"
                                alt="Photo pour le concours"
                            >
                            {% if getPhotoCurrentTheme() %}
                                <span class="d-inline-flex gap-1 text-coral fw-bold mt-3" style="color: var(--coral);">
                                    <i class="bi bi-heart-fill"></i> 248
                                </span>
                            {% endif %}

                        </div>
                        <div class="modal-footer gap-4">
                            {% if not getPhotoCurrentTheme() %}
                                <label class="photo-upload-btn gap-2" title="Selectionnez une photo">
                                    <i class="bi bi-camera-fill"></i> Selectionnez une photo
                                    <input
                                        type="file"
                                        name="file"
                                        data-uploadfile-target="input"
                                        accept="image/*"
                                        data-action="change->uploadfile#onFileChange"
                                        data-url="{{ path("app_photo_chanllenge_update") }}"
                                        data-token="{{ csrf_token('upload-photo-theme') }}"
                                        data-submitType="button"
                                    >
                                </label>
                                <button type="button" class="btn btn-fun" data-action="click->uploadfile#sendFile">Envoyer</button>
                            {% else %}
                                <button type="button" class="btn btn-fun" data-bs-dismiss="modal">Fermer</button>
                            {% endif %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% include 'partials/_footer.html.twig' %}
    </body>
</html>
