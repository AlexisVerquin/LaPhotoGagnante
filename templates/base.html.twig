<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# ---------- SEO ---------- #}
    {% set seo_title = block('full_title') is defined ? block('full_title')|trim
        : (block('title') is defined ? block('title')|trim ~ ' | ' ~ site_name : site_name) %}
    {% set seo_description = (block('meta_description') is defined ? block('meta_description')|trim : '')
        ?: site_name ~ ' : concours photo amateur gratuit. Un thème par concours, une photo par membre, et c\'est la communauté qui vote pour élire la photo gagnante.' %}
    {# Toujours l'adresse de production : la preprod ne fait jamais concurrence au vrai site #}
    {% set seo_url = site_url ~ app.request.pathInfo %}
    {# |raw : le contenu des blocs est déjà échappé par Twig, l'échapper à nouveau doublerait les apostrophes #}
    <title>{{ seo_title|raw }}</title>
    <meta name="description" content="{{ seo_description|raw }}">
    <link rel="canonical" href="{{ seo_url }}">
    {# Hors du vrai domaine (dev, preprod) ou sur une page privée : rien n'est indexé #}
    {% if app.request.host != site_url|split('//')|last or block('noindex') is defined %}
        <meta name="robots" content="noindex, nofollow">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:title" content="{{ seo_title|raw }}">
    <meta property="og:description" content="{{ seo_description|raw }}">
    <meta property="og:url" content="{{ seo_url }}">
    <meta property="og:image" content="{{ site_url ~ asset('images/og-image.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ site_name }}, concours photo amateur gratuit">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#FF6B6B">
    {% block structured_data %}{% endblock %}

    {# Polices et icônes servies par le site : aucune requête vers Google ou un CDN #}
    <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('fonts/bootstrap-icons/bootstrap-icons.min.css') }}">
    {% block stylesheets %}
    {% endblock %}

    <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', {callback: 'fos.Router.setData'}) }}"></script>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

{% set flashList = [] %}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set flashList = flashList|merge([{ type: type, message: message }]) %}
    {% endfor %}
{% endfor %}
{% set subscriptionChangeUrl = (app.user) ? 'app_user_manage' : 'app_register' %}
{% set currentPhoto = getPhotoCurrentTheme() %}

<body
    data-controller="modal uploadfile alert countdown"
    data-alert-flashes-value="{{ flashList|json_encode|e('html_attr') }}"
    data-action="uploadfile:success->modal#close vote:success@window->alert#success vote:error@window->alert#error"
>
<a href="#main-content" class="visually-hidden-focusable">Aller au contenu principal</a>

<div class="container-fluid m-0 p-0">
    {# Zone live : les messages ajoutés par le JS sont annoncés par les lecteurs d'écran #}
    <div
        data-alert-target="container"
        class="position-fixed mb-2 bottom-0 end-0 p-3"
        style="z-index: 1080; min-width: 320px;"
        role="status"
        aria-live="polite"
        aria-atomic="false"
    ></div>

    <header>
        {% include
            'partials/_navbar.html.twig'
            with {'hide_auth_actions': app.request.attributes.get('_route') in ['app_login', 'app_register']}
        %}
    </header>

    <main id="main-content" tabindex="-1">
        {% block body %}{% endblock %}
    </main>
</div>

<div
    class="modal fade"
    id="photo-modal"
    tabindex="-1"
    aria-labelledby="photo-modal-title"
    aria-hidden="true"
    data-modal-target="dialog"
>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="photo-modal-title">
                    {% if not currentPhoto %}Envoyer votre photo{% else %}Votre photo{% endif %}
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <div class="modal-body d-flex flex-column align-items-center">
                <div class="alert alert-danger alert-dismissible fade m-4" role="alert" data-uploadfile-target="alert" hidden>
                    <span data-uploadfile-target="alertMessage"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>

                <img
                    data-uploadfile-target="preview"
                    class="img-fluid"
                    width="600"
                    src="{% if not currentPhoto %}{{ asset('images/default_images.jpg') }}{% else %}{{ currentPhoto['imageUrl'] }}{% endif %}"
                    alt="Aperçu de la photo pour le concours"
                >

                {% if currentPhoto %}
                    {% if currentPhoto['isVisible'] %}
                        <p class="d-inline-flex gap-1 text-coral fw-bold mt-3">
                            <i class="bi bi-heart-fill" aria-hidden="true"></i>
                            <span class="visually-hidden">Nombre de votes :</span>
                            {{ currentPhoto['vote'] }}
                        </p>
                    {% else %}
                        <p class="mt-3">Votre photo est en attente de vérification</p>
                    {% endif %}
                {% endif %}
            </div>

            <div class="modal-footer gap-4">
                {% if not currentPhoto %}
                    <label class="photo-upload-btn gap-2">
                        <i class="bi bi-camera-fill" aria-hidden="true"></i> Sélectionnez une photo
                        <input
                            type="file"
                            name="file"
                            data-uploadfile-target="input"
                            accept="image/*"
                            data-action="change->uploadfile#onFileChange"
                            data-url="{{ path('app_photo_chanllenge_update') }}"
                            data-token="{{ csrf_token('upload-photo-theme') }}"
                            data-submitType="button"
                        >
                    </label>
                    <button type="button" class="btn btn-fun" data-action="click->uploadfile#sendFile">Envoyer</button>
                {% else %}
                    <button type="button" class="btn btn-fun" data-bs-dismiss="modal">Fermer</button>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% include 'partials/_footer.html.twig' %}
</body>
</html>
