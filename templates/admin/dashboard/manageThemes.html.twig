{% extends 'base.html.twig' %}

{% block title %}Gestion des thèmes{% endblock %}

{% block body %}
    <div class="container py-5">

        <div class="mb-4">
            <span class="hero-eyebrow mb-2">
                <i class="bi bi-palette-fill" aria-hidden="true"></i> Administration
            </span>
            <h1 class="hero-title mt-2">Gestion des <span>thèmes</span></h1>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="section-card p-4 p-md-5 h-100">
                    <div class="form-section-title" role="heading" aria-level="2">
                        <span class="form-section-icon icon-info">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        </span>
                        Ajouter un thème
                    </div>

                    {{ form_start(formTheme) }}
                    <div class="mb-3">
                        {{ form_row(formTheme.themeChoice) }}
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_row(formTheme.dateStart) }}
                        </div>
                        <div class="col-6">
                            {{ form_row(formTheme.dateEnd) }}
                        </div>
                    </div>
                    <div class="mb-4">
                        {{ form_row(formTheme.winner) }}
                    </div>
                    <button type="submit" class="btn btn-fun px-4 py-2">
                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Enregistrer
                    </button>
                    {{ form_end(formTheme) }}
                </div>
            </div>

            {% if (actualTheme) %}
                <div class="col-lg-6">
                    <div class="section-card p-4 p-md-5 h-100">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="form-section-title mb-0" role="heading" aria-level="2">
                            <span class="form-section-icon icon-security">
                                <i class="bi bi-stars" aria-hidden="true"></i>
                            </span>
                                Thème en cours
                            </div>
                            <span class="badge-today">En cours</span>
                        </div>

                        <h2 class="mb-1">{{ actualTheme.themeChoice.name }}</h2>
                        <p class="form-hint mb-4">
                            Du {{ actualTheme.dateStart|date('d-m-Y') }}
                            au {{ actualTheme.dateEnd|date('d-m-Y') }}
                        </p>

                        <div class="d-flex gap-3">
                            <div class="profile-mini-stat text-center">
                                <span class="num">18</span>
                                <span class="form-hint">Participants</span>
                            </div>
                            <div class="profile-mini-stat text-center">
                            <span class="num">
                                {{ date(actualTheme.dateEnd).diff(date()).days }}
                            </span>
                                <span class="form-hint">Jours restants</span>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}


        </div>
    </div>
{% endblock %}
