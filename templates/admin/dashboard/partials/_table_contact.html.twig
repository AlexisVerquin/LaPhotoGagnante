{% if contacts|length > 0 %}
    <div class="table-responsive">
        <div class="table-responsive rounded-3 border shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                <tr>
                    <th scope="col" class="py-3 ps-4 text-muted small text-uppercase fw-semibold" style="width: 25%;">Email</th>
                    <th scope="col" class="py-3 text-muted small text-uppercase fw-semibold">Message</th>
                    <th scope="col" class="py-3 pe-4 text-end text-muted small text-uppercase fw-semibold" style="width: 15%;">Actions</th>
                </tr>
                </thead>
                <tbody class="table-group-divider">
                {% for contact in contacts %}
                    <tr>
                        <td class="ps-4 fw-medium text-dark">
                            {{ contact.email }}
                            {% if contact.closedAt %}
                                <div class="small text-muted fw-normal">Clôturé, supprimé le {{ contact.closedAt|date_modify('+24 hours')|date('d/m à H\\hi') }}</div>
                            {% endif %}
                        </td>
                        <td class="text-secondary text-truncate" style="max-width: 400px;">
                            {{ contact.message }}
                        </td>
                        <td class="pe-4 text-end">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Actions sur le message">
                                <a href="{{ path('admin_contact_reply', {id:contact.id}) }}"
                                   class="btn btn-light text-primary border d-flex align-items-center justify-content-center"
                                   data-bs-toggle="tooltip"
                                   data-turbo="false"
                                   title="Répondre"
                                   aria-label="Répondre au message de {{ contact.email }}">
                                    <twig:ux:icon name="lucide:edit-3" class="size-4" aria-hidden="true" />
                                </a>
                                {% if not contact.closedAt %}
                                    <form action="{{ path('admin_contact_close', {id: contact.id}) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('close_contact_' ~ contact.id) }}">
                                        <button type="submit"
                                                class="btn btn-light text-success border d-flex align-items-center justify-content-center"
                                                title="Clôturer (suppression dans 24 h)"
                                                aria-label="Clôturer la demande de {{ contact.email }}, elle sera supprimée dans 24 heures">
                                            <twig:ux:icon name="lucide:circle-check-big" class="size-4" aria-hidden="true" />
                                        </button>
                                    </form>
                                {% endif %}
                                <form
                                    action="{{ path('admin_contact_delete', {id:contact.id}) }}"
                                    onsubmit="return confirm('Supprimer ce message ?')"
                                    method="POST"
                                >
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="message[id]" value="{{ contact.id }}">
                                    <input type="hidden" name="message[csrf]" value="{{ csrf_token('delete_message_'~ contact.id)}}">
                                    <button type="submit" data-bs-toggle="tootip" title="Supprimer" aria-label="Supprimer le message de {{ contact.email }}" class="btn btn-light text-danger border d-flex align-items-center justify-content-center"><twig:ux:icon name="lucide:trash-2" class="size-4" aria-hidden="true" /></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <p class="text-muted mb-0">Pas de nouveau message.</p>
{% endif %}
