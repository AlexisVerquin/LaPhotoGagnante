{% extends 'base.html.twig' %}

{% block title %}Référence des icônes{% endblock %}
{# Page privée : pas d'indexation par les moteurs de recherche #}
{% block noindex %}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="mb-4">
            <span class="hero-eyebrow mb-2">
                <i class="bi bi-speedometer2" aria-hidden="true"></i> Espace admin
            </span>
            <h1 class="hero-title-v2 mt-2 h2">Utils</h1>
        </div>

        <div class="row g-4">
            <div class="col-lg-12">
                <div class="section-card p-4 p-md-5">
                    <div class="form-section-title mb-1" role="heading" aria-level="2">
                        <span class="form-section-icon icon-info">
                            <i class="bi bi-palette2" aria-hidden="true"></i>
                        </span>
                        Icônes disponibles
                    </div>
                    <p class="form-hint mb-4">Cliquez sur une icône pour copier son code.</p>

                    <div class="row g-3">
                        {% set icons = [
                            'lucide:bell',
                            'lucide:circle-check-big',
                            'lucide:trash',
                            'lucide:trash-2',
                            'lucide:edit-3',
                        ] %}

                        {% for icon in icons %}
                            <div class="col-6 col-md-4 col-lg-3">
                                <button type="button"
                                        class="icon-swatch"
                                        data-code="&lt;twig:ux:icon name=&quot;{{ icon }}&quot; /&gt;">
                                <span class="icon-swatch-preview">
                                    <twig:ux:icon name="{{ icon }}" aria-hidden="true" />
                                </span>
                                    <code class="icon-swatch-code">{{ icon }}</code>
                                    <span class="icon-swatch-copied">
                                    <i class="bi bi-check2" aria-hidden="true"></i> Copié !
                                </span>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# ---------- MESSAGES DE CONTACT ---------- #}

    </div>

    <script>
        document.querySelectorAll('.icon-swatch').forEach((btn) => {
            btn.addEventListener('click', () => {
                const code = btn.dataset.code;
                navigator.clipboard.writeText(code).then(() => {
                    btn.classList.add('is-copied');
                    setTimeout(() => btn.classList.remove('is-copied'), 1200);
                });
            });
        });
    </script>
{% endblock %}
