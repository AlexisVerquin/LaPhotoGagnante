{% extends 'base.html.twig' %}

{% block title %}Messages reçus{% endblock %}
{# Page privée : pas d'indexation par les moteurs de recherche #}
{% block noindex %}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="mb-4">
            <span class="hero-eyebrow mb-2">
                <i class="bi bi-speedometer2" aria-hidden="true"></i> Espace admin
            </span>
            <h1 class="hero-title-v2 mt-2 h2">Messages</h1>
        </div>

        <div class="row g-4">
            <div class="col-lg-12">
                <div class="section-card p-4 p-md-5 mt-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-section-title mb-0 d-flex justify-content-between w-100" role="heading" aria-level="2">
                            <div class="d-flex gap-2 align-items-center">
                        <span class="form-section-icon icon-security">
                            <twig:ux:icon name="lucide:bell" aria-hidden="true" />
                        </span>
                                Messages reçus
                            </div>

                        </div>
                        {% if contacts|length > 0 %}
                            <span class="badge-today text-center" style="width: 150px">{{ contacts|length }} message{{ contacts|length > 1 ? 's' : '' }}</span>
                        {% endif %}
                    </div>

                   {% include 'admin/dashboard/partials/_table_contact.html.twig' %}
                </div>
            </div>
        </div>

        {# ---------- MESSAGES DE CONTACT ---------- #}

    </div>
{% endblock %}
