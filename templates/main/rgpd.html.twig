{% extends 'base.html.twig' %}

{% block title %}PhotoPrix - Politique de confidentialité{% endblock %}

{% set url = "[www.site.com](http://www.site.com)" %}
{% set name = "PhotoPrix" %}

{% block body %}
<div class="container py-5">
    <div class="mb-5 text-center">
        <span class="hero-eyebrow mb-3">
            <i class="bi bi-shield-lock" aria-hidden="true"></i> Document légal
        </span>
        <h1 class="hero-title-v2 h2 mt-3 mb-1">Politique de confidentialité</h1>
        <p class="text-muted mb-0">Dernière mise à jour : 01/10/2026</p>
    </div>

    <div class="row g-4">

        {# ---------- SOMMAIRE ---------- #}
        <div class="col-lg-4">
            <div class="section-card p-4 p-md-5" style="position: sticky; top: 2rem;">
                <div class="form-section-title" role="heading" aria-level="2">
                    <span class="form-section-icon icon-info">
                        <i class="bi bi-list-ul" aria-hidden="true"></i>
                    </span>
                    Sommaire
                </div>

                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li>
                        <a href="#responsable-de-traitement"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            1. Responsable de traitement
                        </a>
                    </li>
                    <li>
                        <a href="#donnees-collectees"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            2. Données collectées
                        </a>
                    </li>
                    <li>
                        <a href="#finalites-bases-legales"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            3. Finalités et bases légales
                        </a>
                    </li>
                    <li>
                        <a href="#emails-notifications"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            4. Emails et notifications
                        </a>
                    </li>
                    <li>
                        <a href="#cookies"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            5. Cookies et traceurs
                        </a>
                    </li>
                    <li>
                        <a href="#durees-conservation"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            6. Durées de conservation
                        </a>
                    </li>
                    <li>
                        <a href="#destinataires"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            7. Destinataires des données
                        </a>
                    </li>
                    <li>
                        <a href="#hebergement-securite"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            8. Hébergement et sécurité
                        </a>
                    </li>
                    <li>
                        <a href="#vos-droits"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            9. Vos droits
                        </a>
                    </li>
                    <li>
                        <a href="#mineurs"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            10. Mineurs
                        </a>
                    </li>
                    <li>
                        <a href="#modification-politique"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            11. Modification
                        </a>
                    </li>
                    <li>
                        <a href="#contact"
                           class="text-decoration-none"
                           style="color: var(--ink);">
                            12. Contact
                        </a>
                    </li>
                </ul>
            </div>
        </div>


        {# ---------- CONTENU ---------- #}
        <div class="col-lg-8">
            <div class="section-card p-4 p-md-5">

                {# ---------- 1. RESPONSABLE DE TRAITEMENT ---------- #}
                <div id="responsable-de-traitement" class="mb-5">
                    <h2 class="h5 mb-3">1. Responsable de traitement</h2>

                    <p class="text-muted">
                        Le responsable du traitement des données personnelles collectées sur
                        <span class="fw-bold">{{ name }}</span> (ci-après « le Site ») est :
                    </p>

                    <ul class="text-muted mb-0">
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Nom / raison sociale :
                            </span>
                            Alexis Verquin
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Contact :
                            </span>
                            <a href="mailto:alexis.verquin@gmail.com"
                               style="color: #5b3b9e;">
                                alexis.verquin@gmail.com
                            </a>
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Adresse :
                            </span>
                            Non applicable / à compléter
                        </li>
                    </ul>

                    <p class="text-muted mb-0 mt-3">
                        Pour toute question relative à vos données personnelles, vous pouvez
                        utiliser le formulaire de contact disponible en pied de page du Site.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 2. DONNÉES COLLECTÉES ---------- #}
                <div id="donnees-collectees" class="mb-5">
                    <h2 class="h5 mb-3">2. Données collectées</h2>

                    <p class="text-muted">
                        Dans le cadre de l'utilisation du Site, nous collectons les données
                        suivantes :
                    </p>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <caption class="visually-hidden">Données personnelles collectées et leur caractère obligatoire</caption>
                            <thead>
                            <tr>
                                <th scope="col">Donnée</th>
                                <th scope="col">Obligatoire</th>
                                <th scope="col">Finalité</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>Adresse email</td>
                                <td>Oui</td>
                                <td>Création de compte, connexion et envoi de notifications</td>
                            </tr>
                            <tr>
                                <td>Nom d'utilisateur (pseudo)</td>
                                <td>Oui</td>
                                <td>Identification publique sur le Site</td>
                            </tr>
                            <tr>
                                <td>Mot de passe</td>
                                <td>Oui</td>
                                <td>Sécurisation de l'accès au compte</td>
                            </tr>
                            <tr>
                                <td>Ville</td>
                                <td>Non</td>
                                <td>Information facultative affichée sur le profil</td>
                            </tr>
                            <tr>
                                <td>Avatar</td>
                                <td>Non</td>
                                <td>Photo de profil facultative</td>
                            </tr>
                            <tr>
                                <td>Photos publiées</td>
                                <td>Oui, si participation</td>
                                <td>Participation aux concours photo</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted mb-0">
                        Nous ne collectons
                        <span class="fw-bold" style="color: var(--ink);">
                            aucune donnée sensible
                        </span>
                        (origine, santé, opinions religieuses, politiques, etc.) et ne
                        demandons aucune information au-delà de ce qui est strictement
                        nécessaire au fonctionnement du Site.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 3. FINALITÉS ET BASES LÉGALES ---------- #}
                <div id="finalites-bases-legales" class="mb-5">
                    <h2 class="h5 mb-3">3. Finalités et bases légales du traitement</h2>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <caption class="visually-hidden">Finalités des traitements et bases légales</caption>
                            <thead>
                            <tr>
                                <th scope="col">Finalité</th>
                                <th scope="col">Base légale</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>Création et gestion du compte utilisateur</td>
                                <td>Exécution du contrat</td>
                            </tr>
                            <tr>
                                <td>Participation aux concours photo</td>
                                <td>Exécution du contrat</td>
                            </tr>
                            <tr>
                                <td>Envoi d'un email lors du démarrage d'un nouveau thème ou concours</td>
                                <td>Intérêt légitime, avec possibilité de désinscription</td>
                            </tr>
                            <tr>
                                <td>Réponse aux demandes via le formulaire de contact</td>
                                <td>Intérêt légitime / consentement</td>
                            </tr>
                            <tr>
                                <td>Sécurité du Site et protection contre les abus</td>
                                <td>Intérêt légitime</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr class="form-section-divider">


                {# ---------- 4. EMAILS ---------- #}
                <div id="emails-notifications" class="mb-5">
                    <h2 class="h5 mb-3">4. Emails et notifications</h2>

                    <p class="text-muted">
                        Votre adresse email est utilisée uniquement pour :
                    </p>

                    <ul class="text-muted">
                        <li>vous permettre de vous connecter à votre compte ;</li>
                        <li>vous informer du démarrage d'un nouveau thème de concours.</li>
                    </ul>

                    <p class="text-muted">
                        <span class="fw-bold" style="color: var(--ink);">
                            Vous pouvez vous désinscrire de ces notifications à tout moment
                        </span>,
                        soit en cliquant sur le lien de désinscription présent dans les emails,
                        soit depuis les paramètres de votre profil sur le Site.
                    </p>

                    <p class="text-muted mb-0">
                        Votre adresse email
                        <span class="fw-bold" style="color: var(--ink);">
                            n'est jamais transmise à des tiers
                        </span>
                        et n'est pas utilisée à des fins commerciales ou publicitaires.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 5. COOKIES ---------- #}
                <div id="cookies" class="mb-5">
                    <h2 class="h5 mb-3">5. Cookies et traceurs</h2>

                    <p class="text-muted">
                        Le Site n'utilise
                        <span class="fw-bold" style="color: var(--ink);">
                            aucun cookie de tracking, publicitaire ou de mesure d'audience
                        </span>.
                    </p>

                    <p class="text-muted mb-0">
                        Seuls des cookies techniques strictement nécessaires au fonctionnement
                        du Site peuvent être utilisés, notamment le cookie de session généré
                        par le framework Symfony permettant de maintenir votre connexion
                        pendant votre navigation.
                    </p>

                    <p class="text-muted mb-0 mt-3">
                        Ces cookies ne sont pas utilisés à des fins publicitaires ou de suivi
                        comportemental et relèvent de l'exemption applicable aux cookies
                        strictement nécessaires au fonctionnement du service.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 6. DURÉES ---------- #}
                <div id="durees-conservation" class="mb-5">
                    <h2 class="h5 mb-3">6. Durées de conservation</h2>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <caption class="visually-hidden">Durées de conservation des données</caption>
                            <thead>
                            <tr>
                                <th scope="col">Donnée</th>
                                <th scope="col">Durée de conservation</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>
                                    Données de compte
                                    (email, pseudo, ville, avatar, mot de passe)
                                </td>
                                <td>
                                    Jusqu'à la suppression du compte par l'utilisateur
                                </td>
                            </tr>
                            <tr>
                                <td>Photos publiées lors d'un concours</td>
                                <td>
                                    Le temps du concours concerné, puis suppression
                                </td>
                            </tr>
                            <tr>
                                <td>Photo gagnante d'un concours</td>
                                <td>
                                    Maximum 1 an après la fin du concours
                                </td>
                            </tr>
                            <tr>
                                <td>Messages envoyés via le formulaire de contact</td>
                                <td>
                                    Le temps nécessaire au traitement de la demande
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted mb-0">
                        À l'issue de ces durées, les données sont supprimées ou anonymisées.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 7. DESTINATAIRES ---------- #}
                <div id="destinataires" class="mb-5">
                    <h2 class="h5 mb-3">7. Destinataires des données</h2>

                    <p class="text-muted">
                        Vos données ne sont accessibles qu'à l'éditeur du Site, dans le cadre
                        strict du fonctionnement du service, notamment pour la validation des
                        photos, l'envoi des notifications et la modération.
                    </p>

                    <p class="text-muted">
                        <span class="fw-bold" style="color: var(--ink);">
                            Les photos que vous publiez ne sont utilisées que sur le Site
                        </span>
                        et ne sont ni cédées, ni réutilisées, ni publiées sur un autre
                        support, réseau social ou service tiers sans votre accord explicite.
                    </p>

                    <p class="text-muted mb-0">
                        Aucune donnée n'est vendue, louée ou partagée à des fins commerciales
                        avec des tiers.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 8. HÉBERGEMENT ---------- #}
                <div id="hebergement-securite" class="mb-5">
                    <h2 class="h5 mb-3">8. Hébergement et sécurité</h2>

                    <ul class="text-muted">
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Hébergeur :
                            </span>
                            OVH
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Adresse :
                            </span>
                            À compléter avec l'adresse exacte de l'hébergeur si nécessaire
                        </li>
                    </ul>

                    <p class="text-muted mb-0">
                        Des mesures techniques raisonnables sont mises en œuvre pour protéger
                        vos données, notamment la protection des mots de passe, les connexions
                        sécurisées et la restriction des accès aux données d'administration.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 9. VOS DROITS ---------- #}
                <div id="vos-droits" class="mb-5">
                    <h2 class="h5 mb-3">9. Vos droits</h2>

                    <p class="text-muted">
                        Conformément au RGPD, vous disposez des droits suivants sur vos données
                        personnelles :
                    </p>

                    <ul class="text-muted">
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Droit d'accès :
                            </span>
                            obtenir une copie des données vous concernant ;
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Droit de rectification :
                            </span>
                            corriger des données inexactes ou incomplètes ;
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Droit à l'effacement :
                            </span>
                            demander la suppression de vos données ;
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Droit d'opposition :
                            </span>
                            vous opposer à certains traitements ;
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Droit à la limitation :
                            </span>
                            demander la limitation du traitement de vos données ;
                        </li>
                        <li>
                            <span class="fw-bold" style="color: var(--ink);">
                                Droit à la portabilité :
                            </span>
                            recevoir les données que vous nous avez fournies dans un format
                            structuré.
                        </li>
                    </ul>

                    <h3 class="h6 mt-4 mb-3">Comment exercer vos droits</h3>

                    <p class="text-muted">
                        <span class="fw-bold" style="color: var(--ink);">
                            Suppression de compte :
                        </span>
                        vous pouvez supprimer vous-même votre compte à tout moment depuis
                        votre page de profil.
                    </p>

                    <p class="text-muted">
                        Pour toute autre demande (accès, rectification, opposition,
                        limitation ou portabilité), utilisez le formulaire de contact
                        disponible en pied de page du Site ou écrivez à :
                        <a href="mailto:alexis.verquin@gmail.com"
                           style="color: #5b3b9e;">
                            alexis.verquin@gmail.com
                        </a>.
                    </p>

                    <p class="text-muted">
                        Nous nous engageons à répondre à votre demande dans un délai maximum
                        d'un mois.
                    </p>

                    <p class="text-muted mb-0">
                        Vous disposez également du droit d'introduire une réclamation auprès
                        de la
                        <span class="fw-bold" style="color: var(--ink);">
                            CNIL (Commission Nationale de l'Informatique et des Libertés)
                        </span>
                        si vous estimez que vos droits ne sont pas respectés.
                        <a href="https://www.cnil.fr"
                           target="_blank"
                           rel="noopener noreferrer"
                           style="color: #5b3b9e;">
                            www.cnil.fr
                        </a>
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 10. MINEURS ---------- #}
                <div id="mineurs" class="mb-5">
                    <h2 class="h5 mb-3">10. Mineurs</h2>

                    <p class="text-muted mb-0">
                        Le Site n'est pas spécifiquement destiné à un public mineur.
                        Si vous êtes mineur, l'inscription doit se faire avec l'accord de
                        votre représentant légal.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 11. MODIFICATION ---------- #}
                <div id="modification-politique" class="mb-5">
                    <h2 class="h5 mb-3">11. Modification de la politique de confidentialité</h2>

                    <p class="text-muted mb-0">
                        Cette politique peut être mise à jour à tout moment, notamment afin
                        de tenir compte d'une évolution légale ou réglementaire.
                        La date de dernière mise à jour figure en haut de ce document.
                        Nous vous invitons à consulter régulièrement cette page.
                    </p>
                </div>

                <hr class="form-section-divider">


                {# ---------- 12. CONTACT ---------- #}
                <div id="contact" class="mb-0">
                    <h2 class="h5 mb-3">12. Contact</h2>

                    <p class="text-muted mb-0">
                        Pour toute question relative à cette politique ou à vos données
                        personnelles, utilisez le formulaire de contact disponible en pied
                        de page du Site ou écrivez à :
                        <a href="mailto:alexis.verquin@gmail.com"
                           style="color: #5b3b9e;">
                            alexis.verquin@gmail.com
                        </a>.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}
