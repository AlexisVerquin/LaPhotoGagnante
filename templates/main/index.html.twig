{% extends 'base.html.twig' %}

{% block title %}PhotoPrix - Accueil{% endblock %}


{% set surveyResponding = (app.user) ? 'app_main_vote' : 'app_register' %}

{% block body %}
    <div
        class="container py-5"

        data-action="survey:success@window->alert#success survey:error@window->alert#error"
    >
        {% if getCurrentTheme() %}
            <div>

                {# ---------- HERO ---------- #}
                <div class="row align-items-center mb-5 pt-3">
                    <div class="col-lg-7">
                        <span class="hero-eyebrow mb-3">
                            <i class="bi bi-stars"></i> Concours en cours
                        </span>
                        <h1 class="hero-title-v2 display-4 mb-3">
                            <span class="hero-highlight">{{ actualTheme.themeChoice.name }}</span>
                        </h1>
                        <p class="text-muted fs-5">
                            Chaque mois, un nouveau thème, une nouvelle façon de voir le monde.
                            Partagez votre regard, votez pour vos photos préférées et tentez de
                            devenir la photo du mois.
                        </p>

                        <div class="d-flex flex-wrap gap-3">
                            <a href="{{ path(subscriptionChangeUrl) }}" {% if app.user %} data-action="click->modal#showModal" {% endif %}
                               class="btn btn-fun btn-lg px-4">
                                <i class="bi bi-camera-fill me-2"></i> {% if not hasPhoto %} Participer au concours {% else %} Voir ma photo {% endif %}
                            </a>

                            <a href="{{ path('app_gallery') }}" class="btn btn-lg px-4 btn-outline-dark rounded-3"
                               data-countdown-target="galleryButton">
                                Voir la galerie
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-5 d-none d-lg-flex justify-content-center mt-5 mt-lg-0">
                        <div class="polaroid" style="width: 260px;">
                            <img src="{{ asset('images/photo_foret.webp') }}" alt="Photo exemple">
                            <div class="polaroid-caption">Forêt de Sautron</div>
                        </div>
                    </div>
                </div>

                {# ---------- PHOTO DU JOUR + COMPTE A REBOURS ---------- #}
                <div class="row g-4 mb-5">
                    {% if (photoOfTheDay and photoOfTheDay[0].isVisible ) %}
                        <div class="col-lg-7">
                            <div class="section-card p-4 p-md-5 h-100">
                                <div class="d-flex justify-content-between align-items-start mb-4">
                                    <div>
                                    <span class="badge-today mb-2 d-inline-block">
                                        <i class="bi bi-sun-fill me-1"></i>Photo du jour
                                    </span>
                                        <h2 class="h4 mb-0">Le coup de cœur de la communauté</h2>
                                        <i>La photo ayant obtenu le plus de votes aujourd'hui</i>
                                    </div>
                                </div>

                                <div class="row align-items-center g-4">
                                    <div class="col-sm-5">
                                        <div class="polaroid mx-auto" style="max-width: 220px;">
                                            <img
                                                src="{{ asset("uploads/themes/"~ photoOfTheDay[0].theme.directoryName ~"/"~photoOfTheDay[0].name) }}"
                                                alt="Photo du jour">
                                            <div
                                                class="polaroid-caption">{{ photoOfTheDay[0].createdAt|date('d/m/Y') }}</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-7">
                                        <h3 class="h5 mb-1">
                                            « {{ (photoOfTheDay[0].title) ? photoOfTheDay[0].title : "Quelle beauté" }}
                                            »</h3>
                                        <p class="text-muted small mb-3">par
                                            <strong>{{ photoOfTheDay[0].user.name }}</strong>
                                            — {{ photoOfTheDay[0].user.city }}</p>
                                        <p class="mb-4">
                                            {{ (photoOfTheDay[0].description) ? photoOfTheDay[0].description : "" }}
                                        </p>
                                        <div class="d-flex align-items-center gap-3">
                                    <span class="d-inline-flex align-items-center gap-1 text-coral fw-bold"
                                          style="color: var(--coral);">
                                        <i class="bi bi-heart-fill"></i> {{ photoOfTheDay.nbVotes }}
                                    </span>
                                            <a href="#" class="btn-vote">Voir en grand</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    {% endif %}
                    {% include 'partials/_countdown.html.twig' with {'photoOfTheDay' : photoOfTheDay } %}
                </div>
            </div>
        {% else %}
            <div class="section-card p-4 p-md-5 mb-5">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6 order-2 order-lg-1">
                <span class="hero-eyebrow mb-3">
                    <i class="bi bi-hourglass"></i> Entre deux concours
                </span>
                        <h2 class="h3 mt-3 mb-3">Aucun concours en cours pour le moment</h2>
                        <p class="text-muted fs-6 mb-4">
                            Le prochain thème arrive bientôt. En attendant, découvrez qui a
                            remporté le dernier concours, ou proposez le thème du mois prochain
                            juste en dessous.
                        </p>

                        {% if lastTheme and lastTheme.winner %}
                            <div class="d-flex gap-4 mb-4">
                                <div>
                            <span class="stat-number d-block" style="font-size: 1.6rem;">
                               80
                            </span>
                                    <span class="text-muted small">Votes reçus</span>
                                </div>
                                <div>
                            <span class="stat-number d-block" style="font-size: 1.6rem;">
                                {{ lastTheme.dateStart|date('d/m') }} — {{ lastTheme.dateEnd|date('d/m') }}
                            </span>
                                    <span class="text-muted small">Durée du concours</span>
                                </div>
                            </div>
                        {% endif %}

                        <a href="{{ path('app_gallery') }}" class="btn btn-fun px-4 py-2">
                            <i class="bi bi-images me-2"></i>Voir la galerie complète
                        </a>
                    </div>

                    <div class="col-lg-6 order-1 order-lg-2">
                        {% if lastTheme and lastTheme.winner %}
                            <div class="countdown-panel p-4 p-md-5 text-center position-relative">
                                <div class="position-relative">
                            <span class="badge-today mb-3 d-inline-block">
                                <i class="bi bi-trophy-fill me-1"></i>Gagnant du dernier concours
                            </span>
                                    <h3 class="h5 mb-4" style="color: var(--cream);">
                                        {{ lastTheme.themeChoice.name }}
                                    </h3>

                                    <div class="d-flex justify-content-center">
                                        <div class="polaroid" style="width: 220px;">
                                            <img src="{{ asset('images/jcvd.jpeg') }}" alt="Photo gagnante">
                                            <div class="polaroid-caption">
                                                {{ lastTheme.winner.name }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-center mt-3">
                                <span class="d-inline-flex align-items-center gap-1 fw-bold"
                                      style="color: var(--coral);">
                                    <i class="bi bi-heart-fill"></i> 80 votes
                                </span>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="d-flex justify-content-center">
                                <div class="polaroid" style="width: 240px; transform: rotate(2deg);">
                                    <img src="https://picsum.photos/seed/comingsoon/400/500"
                                         alt="Bientôt un nouveau concours">
                                    <div class="polaroid-caption">À vos objectifs !</div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        {# ---------- VOTE PROCHAIN THEME ---------- #}
        {% if activeSurvey %}
            <div class="section-card p-4 p-md-5 mb-5">
                <div class="text-center mb-4">
                <span class="hero-eyebrow mb-3">
                    <i class="bi bi-check2-square"></i> À vous de choisir
                </span>
                    <h2 class="h3 mt-3 mb-1">Votez pour le prochain thème </h2>
                    <p class="text-muted mb-0">Le thème le plus voté sera lancé le 1er du mois.</p>

                </div>
                <div class="row g-3">
                    {% for theme in activeSurvey.surveyChoices %}
                        {% set percentVote = 0 %}
                        {% if totalVoteSurvey != 0 %}
                            {% set percentVote = ((theme.numberVoter) / totalVoteSurvey) * 100 %}
                        {% endif %}

                        <div
                            class="col-md-4"
                            data-controller="survey"
                            data-survey-themeid-value="{{ theme.id }}"
                            data-survey-total-value="{{ totalVoteSurvey }}"
                            data-survey-vote-value="{{ theme.numberVoter }}"
                            data-survey-route-value="{{ path('app_main_vote') }}"
                            data-survey-csrf-value="{{ csrf_token('survey-vote') }}"
                        >
                            <div class="theme-vote-card is-leading">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="h6 mb-0">{{ theme.name }}</h3>
                                    <span class="badge rounded-pill"
                                          style="background: var(--sunshine); color: var(--ink);">En tête</span>
                                </div>
                                <p class="text-muted small mb-3">{{ theme.description }}</p>
                                <div class="theme-vote-progress mb-1">
                                    {% set widthBar = "width: "~ percentVote ~"%" %}
                                    <div data-survey-target="progressbar" class="theme-vote-progress-bar"
                                         style="{{ widthBar }};"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="small text-muted"><span
                                        data-survey-target="pourcentVote">{{ percentVote|round }} %</span> · <span
                                        data-survey-target="numberVote">{{ theme.numberVoter }}</span> votes</span>
                                    <button type="button" class="btn-vote {% if alreadyVoted %} btn-disabled {% endif %}"
                                            data-action="click->survey#updateVote" {% if alreadyVoted %} disabled {% endif %}>
                                        Voter
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="text-muted mb-0 text-center mt-2">Vous pouvez voter une fois par jour</p>
            </div>
        {% endif %}


        {# ---------- COMMENT PARTICIPER ---------- #}
        <div class="mb-5">
            <div class="text-center mb-4">
                <h2 class="h3 mb-1">Comment participer ?</h2>
                <p class="text-muted mb-0">Trois étapes, aucune complication.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex gap-3">
                        <div class="step-badge">1</div>
                        <div>
                            <h3 class="h6 mb-1">Créez votre compte</h3>
                            <p class="text-muted small mb-0">Inscription gratuite en moins d'une minute.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-3">
                        <div class="step-badge">2</div>
                        <div>
                            <h3 class="h6 mb-1">Envoyez votre photo</h3>
                            <p class="text-muted small mb-0">Une photo, un thème, votre regard.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-3">
                        <div class="step-badge">3</div>
                        <div>
                            <h3 class="h6 mb-1">Votez et partagez</h3>
                            <p class="text-muted small mb-0">Soutenez vos photos préférées jusqu'au verdict.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ---------- DERNIERS GAGNANTS ---------- #}
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-2">
                <div>
                    <h2 class="h3 mb-1">Les derniers gagnants</h2>
                    <p class="text-muted mb-0">Un thème, un vainqueur, chaque mois.</p>
                </div>
{#                <a href="#" class="d-none d-md-inline-block fw-bold text-decoration-none" style="color: var(--grape);">#}
{#                    Voir le palmarès →#}
{#                </a>#}
            </div>
            <div class="gallery-scroll d-flex gap-4">
{#                {% for theme in allThemes %}#}
{#                    {% if theme.winner %}#}
{#                        {{ dump(theme.winner.photos) }}#}
{#                        <div class="polaroid polaroid-mini">#}
{#                            <img src="https://picsum.photos/seed/win1/300/300" alt="Gagnant">#}
{#                            <div class="polaroid-caption">Juillet — {{ theme.themeChoice.name }}</div>#}
{#                        </div>#}
{#                    {% endif %}#}
{#                {% endfor %}#}

                <div class="polaroid polaroid-mini">
                    <img src="https://picsum.photos/seed/win2/300/300" alt="Gagnant">
                    <div class="polaroid-caption">Juin — Vertige</div>
                </div>
                <div class="polaroid polaroid-mini">
                    <img src="https://picsum.photos/seed/win3/300/300" alt="Gagnant">
                    <div class="polaroid-caption">Mai — Instantané</div>
                </div>
                <div class="polaroid polaroid-mini">
                    <img src="https://picsum.photos/seed/win4/300/300" alt="Gagnant">
                    <div class="polaroid-caption">Avril — Brume</div>
                </div>
                <div class="polaroid polaroid-mini">
                    <img src="https://picsum.photos/seed/win5/300/300" alt="Gagnant">
                    <div class="polaroid-caption">Mars — Racines</div>
                </div>
            </div>
        </div>

        {# ---------- STATS ---------- #}
        <div class="stats-strip p-4 p-md-5">
            <div class="row text-center g-4">
                <div class="col-6 col-md-3">
                    <div class="stat-number">{{ nbPhoto }}</div>
                    <div class="text-muted small">Photos envoyées</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number">{{ nbUsers }}</div>
                    <div class="text-muted small">Photographes</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number">{{ nbVotes }}</div>
                    <div class="text-muted small">Votes exprimés</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-number">{{ nbThemes }}</div>
                    <div class="text-muted small">Concours organisés</div>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
