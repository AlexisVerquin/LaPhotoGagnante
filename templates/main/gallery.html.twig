{% extends 'base.html.twig' %}

{% block title %}PhotoPrix - Galerie du concours{% endblock %}

{% set pathCurrentTheme = getPathCurrentTheme() %}
{% set pathAvatar = getPathAvatar() %}

{% block stylesheets %}
    {{ parent() }}
    <style>

    </style>
{% endblock %}

{% block body %}
    <div
        class="container py-5"
    >
        {% if actualTheme %}
            <div class="text-center mb-5">
            <span class="hero-eyebrow mb-3">
                <i class="bi bi-images" aria-hidden="true"></i> Galerie du concours
            </span>
                <h1 class="hero-title-v2 display-4 mt-4 mb-2">
                    <span class="hero-highlight">{{ actualTheme.themeChoice.name }}</span>
                </h1>
                <p class="text-muted mb-0 fs-5">
                    {{ actualTheme.photos|length }} photo{{ actualTheme.photos|length > 1 ? 's' : '' }}
                    partagée{{ actualTheme.photos|length > 1 ? 's' : '' }} par la communauté
                </p>
            </div>

            {% include 'partials/_countdown.html.twig' with {'photoOfTheDay' : false} %}

            {% set visiblePhotos = actualTheme.photos.toArray|filter(p => p.isVisible) %}
            {% if visiblePhotos|length > 0 %}
                <div class="gallery-masonry">
                    {% for photo in visiblePhotos %}
                        <div class="gallery-card">
                            <div class="card p-3">
                                <div class="card-head gap-3 d-flex align-items-center ms-2 mb-3">
                                    <img class="rounded-circle navbar-avatar"
                                         src="{{ getAvatar(photo.user) }}"
                                         alt="">
                                    <div class="fw-bold">{{ photo.user.name }}</div>
                                </div>

                                <div class="card-body p-0">
                                    <p>{{ photo.title }}</p>
                                    <img class="rounded w-100"
                                         src="{{ asset(pathCurrentTheme ~ '/' ~ photo.name) }}"
                                         alt="Photo de {{ photo.user.name }} pour le thème {{ actualTheme.themeChoice.name }}">
                                    <p>{{ photo.description }}</p>
                                </div>

                                <div class="card-footer d-flex align-items-center justify-content-end bg-transparent border-0 pt-3 px-0"
                                     data-controller="vote"
                                     data-vote-theme-value="{{ actualTheme.id }}"
                                     data-vote-photo-value="{{ photo.id }}"
                                     data-vote-csrf-value="{{ csrf_token('vote-photo-theme') }}"
                                     data-vote-url-value="{{ path('app_vote') }}"
                                >
                                    {% if enableVote %}
                                        <button
                                            type="button"
                                            class="vote-heart {% if voteUser and photo.id == voteUser.photo.id %}is-voted{% endif %}"
                                            data-vote-target="button"
                                            data-countdown-target="voteGallery"
                                            data-action="click->vote#submitVote"
                                            aria-pressed="{{ voteUser and photo.id == voteUser.photo.id ? 'true' : 'false' }}"
                                            aria-label="Voter pour la photo de {{ photo.user.name }}"
                                        >
                                            <i class="bi bi-heart-fill vote-heart-icon" aria-hidden="true"></i>
                                            <span class="vote-heart-count" data-vote-target="count">{{ photo.votes|length }}</span>
                                        </button>
                                    {% endif %}

                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="section-card p-4 p-md-5 text-center">
                    <span class="hero-eyebrow mb-3">
                        <i class="bi bi-camera" aria-hidden="true"></i> C'est calme par ici
                    </span>
                    <h2 class="h5 mt-3 mb-2">Aucune photo en ligne pour l'instant</h2>
                    <p class="text-muted mb-0">Soyez le premier à participer à ce thème !</p>
                </div>
            {% endif %}
        {% else %}
            <div class="section-card p-4 p-md-5 text-center">
                <span class="hero-eyebrow mb-3">
                    <i class="bi bi-hourglass" aria-hidden="true"></i> Entre deux concours
                </span>
                <h1 class="h4 mt-3 mb-2">Aucun concours en cours pour le moment</h1>
                <p class="text-muted mb-0">Revenez bientôt pour découvrir les nouvelles photos !</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
