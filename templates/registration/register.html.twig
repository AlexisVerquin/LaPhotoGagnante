{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <div class="container">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger alert-dismissible fade show mt-3 rounded-4" role="alert">
                {{ flash_error }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-11 col-sm-9 col-md-7 col-lg-5">
                <div class="card register-card p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div
                            class="d-inline-flex align-items-center justify-content-center rounded-circle register-icon mb-3">
                            <i class="bi bi-camera-fill fs-3"></i>
                        </div>
                        <h1 class="h3 mb-1">Créer un compte</h1>
                        <p class="text-muted small mb-0">Rejoignez la communauté et partagez vos plus belles photos
                            ✨</p>
                    </div>

                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}

                    <div class="mb-3 text-start">
                        {{ form_label(registrationForm.email, 'Adresse email', {'label_attr': {'class': 'form-label fw-bold small'}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control form-control-fun', 'placeholder': 'vous@exemple.com'}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3 text-start">
                        {{ form_label(registrationForm.name, 'Nom d’utilisateur', {'label_attr': {'class': 'form-label fw-bold small'}}) }}
                        {{ form_widget(registrationForm.name, {'attr': {'class': 'form-control form-control-fun', 'placeholder': 'Votre pseudo'}}) }}
                        {{ form_errors(registrationForm.name) }}
                    </div>

                    <div class="mb-3 text-start">
                        {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'form-label fw-bold small'}}) }}
                        {{ form_widget(
                            registrationForm.plainPassword,
                            {'attr':
                                {
                                    'class': 'form-control form-control-fun',
                                    'placeholder': '••••••••',
                                }
                            }
                        ) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="form-check mb-4 text-start">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(registrationForm.agreeTerms, 'J’accepte les conditions d’utilisation', {'label_attr': {'class': 'form-check-label small'}}) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn btn-fun btn-lg w-100">
                        S’inscrire
                    </button>

                    {{ form_end(registrationForm) }}

                    <p class="text-center small text-muted mt-4 mb-0">
                        Déjà inscrit ? <a href="{{ path('app_login') }}" class="register-link text-decoration-none">Connectez-vous</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
