{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="card register-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <h1 class="h3 mb-1">Contactez-moi</h1>
                </div>
                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                    </div>

                    {{ form_row(form.message) }}

                    {# Le pot de miel anti-spam, caché aux humains comme aux lecteurs d'écran #}
                    <div class="position-absolute" style="left: -10000px;" aria-hidden="true">
                        {{ form_row(form.website) }}
                    </div>
                    <p class="text-muted small mt-3 mb-0">
                        Votre message et votre email servent uniquement à vous répondre : ils sont supprimés 24 h après la clôture de votre demande.
                        En savoir plus : <a href="{{ path('app_rgpd') }}">politique de confidentialité</a>.
                    </p>
                    <button class="btn btn-fun btn-lg mt-3 w-25">Envoyer</button>
                {{ form_end(form) }}

            </div>
        </div>
    </div>

{% endblock %}
