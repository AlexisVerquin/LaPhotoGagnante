{% set resetUrl = url('app_reset_password', {token: resetToken.token}) %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation de votre mot de passe</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F5F3EF;">

<!-- Wrapper -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F5F3EF;">
    <tr>
        <td align="center" style="padding: 40px 16px;">

            <!-- Card -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 560px; background-color: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 45px -25px rgba(45, 42, 50, 0.35);">

                <!-- Bandeau -->
                <tr>
                    <td style="background-color: #2D2A32; padding: 28px 40px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="width: 36px;">
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td style="width: 36px; height: 36px; border-radius: 10px; background-color: #FF6B6B; text-align: center; vertical-align: middle;">
                                                <span style="font-size: 18px; line-height: 36px; color: #ffffff;">📷</span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="padding-left: 12px; font-family: 'Poppins', Helvetica, Arial, sans-serif; font-weight: 800; font-size: 18px; color: #ffffff;">
                                    [Nom du site]
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- Icône centrale -->
                <tr>
                    <td align="center" style="padding: 40px 40px 0 40px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="width: 72px; height: 72px; border-radius: 50%; background-color: #F6F2FF; text-align: center; vertical-align: middle;">
                                    <span style="font-size: 32px; line-height: 72px;">🔒</span>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- Contenu -->
                <tr>
                    <td align="center" style="padding: 24px 40px 40px 40px;">

                        <h1 style="margin: 0 0 14px 0; font-family: 'Poppins', Helvetica, Arial, sans-serif; font-weight: 800; font-size: 22px; color: #2D2A32; text-align: center;">
                            Réinitialisez votre mot de passe
                        </h1>

                        <p style="margin: 0 0 28px 0; font-family: Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #55505A; text-align: center;">
                            Nous avons reçu une demande de réinitialisation du mot de passe de votre compte. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
                        </p>

                        <!-- CTA -->
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 24px;">
                            <tr>
                                <td style="background-color: #FF6B6B; border-radius: 50px;">
                                    <a href="{{ resetUrl }}" target="_blank" style="display: inline-block; padding: 14px 32px; font-family: 'Poppins', Helvetica, Arial, sans-serif; font-weight: 700; font-size: 15px; color: #2D2A32; text-decoration: none;">
                                        Choisir un nouveau mot de passe
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #5f5a63; text-align: center;">
                            Ce lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                        </p>

                        <!-- Lien de secours -->
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 28px;">
                            <tr>
                                <td style="background-color: #F9F7F3; border-radius: 12px; padding: 16px 20px;">
                                    <p style="margin: 0 0 6px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #5f5a63;">
                                        Le bouton ne fonctionne pas ? Copiez-collez ce lien dans votre navigateur :
                                    </p>
                                    <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; word-break: break-all;">
                                        <a href="{{ resetUrl }}" style="color: #5b3b9e;">{{ resetUrl }}</a>
                                    </p>
                                </td>
                            </tr>
                        </table>

                        <!-- Avertissement sécurité -->
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 16px;">
                            <tr>
                                <td style="background-color: #FFF9EA; border-left: 4px solid #FFC93C; border-radius: 12px; padding: 14px 18px;">
                                    <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #8A6B00;">
                                        <strong>Vous n'êtes pas à l'origine de cette demande ?</strong><br>
                                        Ignorez simplement cet email : votre mot de passe actuel reste inchangé.
                                    </p>
                                </td>
                            </tr>
                        </table>

                    </td>
                </tr>

                <!-- Séparateur -->
                <tr>
                    <td style="padding: 0 40px;">
                        <hr style="border: none; border-top: 2px dashed #EFEAE0; margin: 0;">
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="padding: 28px 40px 36px 40px;">
                        <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #5f5a63; text-align: center;">
                            [Nom du site] — [URL du site]
                        </p>
                    </td>
                </tr>

            </table>
            <!-- /Card -->

        </td>
    </tr>
</table>
<!-- /Wrapper -->

</body>
</html>
