{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre boîte mail{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center mt-5 min-vh-100">
            <div class="col-12">
                <div class="card register-card p-md-5">

                    <div class="text-center mb-4">
                        <div
                            class="d-inline-flex align-items-center justify-content-center rounded-circle register-icon mb-3">
                            <i class="bi bi-camera-fill fs-3" aria-hidden="true"></i>
                        </div>
                        <h1 class="h3 mb-1">Mot de passe oublié</h1>
                    </div>

                    {% for flash_error in app.flashes('reset_password_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    <p>
                        Si un compte correspondant à votre adresse e-mail existe, alors un e-mail contenant un lien que vous pouvez utiliser pour réinitialiser votre mot de passe vient d’être envoyé.
                        Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                    </p>
                    <p>Si vous ne recevez pas d’e-mail, veuillez vérifier votre dossier de courriers indésirables ou <a href="{{ path('app_forgot_password_request') }}">réessayez</a>.</p>


                </div>
            </div>
        </div>
    </div>
    {% endblock %}
